---
layout: layout.njk
title: Home
---

<p>{{ site.bio | safe }}</p>

<h2>Posts</h2>
<ul class="post-list">
  {% for post in collections.posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date('yyyy-MM-dd') }}</time>
  </li>
  {% endfor %}
</ul>

<h2>In the media</h2>
<ul class="media-list">
  {% for item in media | sort(true, false, 'date') %}
  <li>
    <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
    <div class="media-meta">
      <span class="outlet">{{ item.outlet }}</span> ·
      <time datetime="{{ item.date }}">{{ item.date | readableDate }}</time>
    </div>
    {% if item.note %}<p class="media-note">{{ item.note }}</p>{% endif %}
  </li>
  {% endfor %}
</ul>
